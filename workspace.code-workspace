{
	"folders": [
		{
			"path": ".",
			"name": "root"
		},
		{
			"path": "./apps",
			"name": "apps"
		},
		{
			"path": "./packages",
			"name": "packages"
		}
	],
	"settings": {
		"explorer.fileNesting.enabled": true,
		"explorer.fileNesting.patterns": {
			"*.tsx": "${capture}.scss, ${capture}.spec.tsx",
			"wrangler.json": "worker-configuration.d.ts",
			"wrangler.jsonc": "worker-configuration.d.ts",
			"package.json": "bun.lock, project.json, .depcheckrc, .clocignore",
			"vite.config.ts": "vite-env.d.ts",
			"README.md": ".gitignore, .gitattributes, .pre-commit-config.yaml",
			"workspace.code-workspace": "nx.json, biome.json"
		},
		"explorer.excludeGitIgnore": false,
		"explorer.sortOrder": "foldersNestsFiles",
		"files.exclude": {
			"**/node_modules": true,
			"**/.react-router": true,
			"**/.wrangler": true,
			"**/*.tsbuildinfo": true,
			"apps": true,
			"packages": true,
			"projects": true,
			"bun.lock": true
		},
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "biomejs.biome",
		"editor.codeActionsOnSave": {
			"source.organizeImports.biome": "explicit",
			"source.fixAll.biome": "explicit"
		},
		"editor.definitionLinkOpensInPeek": false,
		"editor.gotoLocation.multipleImplementations": "goto",
		"editor.gotoLocation.multipleDefinitions": "goto",
		"editor.gotoLocation.multipleReferences": "goto",
		"editor.gotoLocation.multipleTypeDefinitions": "goto",
		"editor.gotoLocation.multipleDeclarations": "goto",
		"scss.format.preserveNewLines": true,
		"[scss]": {
			"editor.defaultFormatter": "sibiraj-s.vscode-scss-formatter"
		},
		"[terraform]": {
			"editor.defaultFormatter": "hashicorp.terraform"
		},
		"nxConsole.generateAiAgentRules": true,
		"[typescript]": {
			"editor.defaultFormatter": "biomejs.biome"
		},
		"[html]": {
			"editor.defaultFormatter": "vscode.html-language-features"
		}
	}
}
