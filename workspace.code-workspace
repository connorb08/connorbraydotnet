{
	"folders": [
		{
			"path": ".",
			"name": "root"
		},
		{
			"path": "./packages/site",
			"name": "site"
		},
		{
			"path": "./packages/resume",
			"name": "resume"
		},
		{
			"path": "./packages/content-manager",
			"name": "content-manager"
		},
		{
			"path": "./packages/shared",
			"name": "shared"
		}
	],
	"settings": {
		"explorer.fileNesting.enabled": true,
		"explorer.fileNesting.patterns": {
			"*.tsx": "${capture}.scss, ${capture}.spec.tsx",
			"wrangler.jsonc": "worker-configuration.d.ts",
			"package.json": "bun.lock, project.json, .depcheckrc, .clocignore",
			"vite.config.ts": "vite-env.d.ts",
			"README.md": ".gitignore, .gitattributes, .pre-commit-config.yaml",
			"workspace.code-workspace": "nx.json, biome.json"
		},
		"explorer.excludeGitIgnore": false,
		"explorer.sortOrder": "foldersNestsFiles",
		"files.exclude": {
			"**/node_modules": true,
			"**/.react-router": true,
			"**/.wrangler": true,
			"**/*.tsbuildinfo": true,
			"**/build": true,
			"packages": true
		},
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "biomejs.biome",
		"editor.codeActionsOnSave": {
			"source.organizeImports.biome": "explicit",
			"quickfix.biome": "explicit"
		},
		"editor.definitionLinkOpensInPeek": false,
		"editor.gotoLocation.multipleImplementations": "goto",
		"editor.gotoLocation.multipleDefinitions": "goto",
		"editor.gotoLocation.multipleReferences": "goto",
		"editor.gotoLocation.multipleTypeDefinitions": "goto",
		"editor.gotoLocation.multipleDeclarations": "goto",
		"[scss]": {
			"editor.defaultFormatter": "vscode.css-language-features"
		},
		"[terraform]": {
			"editor.defaultFormatter": "hashicorp.terraform"
		},
		"nxConsole.generateAiAgentRules": true
	}
}
