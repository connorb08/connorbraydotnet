{
	"compilerOptions": {
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo/tsconfig.tsbuildinfo",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"types": ["./worker-configuration.d.ts", "node"]
	}
}
