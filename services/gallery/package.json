{
	"name": "gallery",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"typecheck": "bun run typegen && tsc --noEmit",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "*",
		"@aws-sdk/s3-request-presigner": "*",
		"hono": "*"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "*",
		"@types/node": "*",
		"vite": "*",
		"wrangler": "*"
	},
	"peerDependencies": {}
}
