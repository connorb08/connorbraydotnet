{
	"name": "queens",
	"version": "0.0.0",
	"dependencies": {
		"@cloudflare/playwright": "^0.0.10",
		"clog": "workspace:*",
		"types": "workspace:*"
	},
	"peerDependencies": {
		"typescript": "*",
		"wrangler": "*",
		"playwright": "*",
		"vitest": "*",
		"@cloudflare/vitest-pool-workers": "*"
	},
	"imports": {
		"#src/*": "./src/*.ts",
		"#worker": "./worker/index.ts"
	},
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"start": "wrangler dev",
		"dev": "bun run dev.ts",
		"typegen": "wrangler types -c wrangler.json -c $DATABASE_DIR/wrangler.json",
		"pretypecheck": "bun run typegen",
		"typecheck": "tsc -b",
		"test": "vitest --run"
	}
}
