{
	"folders": [
		{
			"path": ".",
			"name": "root"
		},
		{
			"path": "./sites",
			"name": "sites"
		},
		{
			"path": "./services",
			"name": "services"
		},
		{
			"path": "./packages",
			"name": "packages"
		}
	],
	"settings": {
		"explorer.fileNesting.enabled": true,
		"explorer.fileNesting.patterns": {
			"package.json": "nx.json, biome.json, project.json",
			"*.tsx": "${capture}.scss, ${capture}.module.scss, ${capture}.spec.tsx",
			"wrangler.json": "worker-configuration.d.ts, .dev.vars",
			"vite.config.ts": "vite-env.d.ts",
			"README.md": ".gitignore, .gitattributes, .pre-commit-config.yaml, .depcheckrc, .clocignore",
			"connorbraydotnet.code-workspace": "*.code-workspace"
		},
		"explorer.excludeGitIgnore": false,
		"explorer.sortOrder": "foldersNestsFiles",
		"files.exclude": {
			"**/node_modules": true,
			"**/.react-router": true,
			"**/.wrangler": true,
			"**/*.tsbuildinfo": true,
			"bun.lock": true,
			"sites/": true,
			"services/": true,
			"packages/": true
		},
		"editor.codeActionsOnSave": {
			"source.organizeImports.biome": "explicit",
			"source.fixAll.biome": "explicit"
		},
		"editor.definitionLinkOpensInPeek": false,
		"editor.gotoLocation.multipleImplementations": "goto",
		"editor.gotoLocation.multipleDefinitions": "goto",
		"editor.gotoLocation.multipleReferences": "goto",
		"editor.gotoLocation.multipleTypeDefinitions": "goto",
		"editor.gotoLocation.multipleDeclarations": "goto",
		"scss.format.preserveNewLines": true
	}
}
