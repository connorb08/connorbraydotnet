{
	"name": "linkedin-game-solver",
	"version": "1.0.0",
	"author": "Connor Bray",
	"main": "src/index.ts",
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^24.0.10",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"esbuild": "^0.25.5",
		"playwright": "^1.53.2"
	},
	"description": "",
	"imports": {
		"#config": "./src/config.ts",
		"#types": "./src/types.ts",
		"#utils/*": "./src/utils/*.ts",
		"#src/*": "./src/*"
	},
	"keywords": [],
	"license": "MIT",
	"scripts": {
		"playwright:setup": "playwright install chromium && playwright install-deps chromium",
		"queens": "bun run src/index.ts",
		"dev": "npx tsx src/index.ts",
		"cf": "wrangler dev --remote",
		"build": "node build.ts",
		"docker:build": "docker build -t linkedin-game-solver .",
		"docker:run": "docker run linkedin-game-solver",
		"docker:attach": "docker run -it --entrypoint=/bin/sh linkedin-game-solver"
	},
	"type": "module"
}
