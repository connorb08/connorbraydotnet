/**
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "linkedin-games",
	"main": "worker/index.ts",
	"compatibility_date": "2025-05-06",
	"workers_dev": true,
	"triggers": {
		"crons": [
			"0 14 * * *"
		]
	},
	"containers": [
		{
			"class_name": "DockerContainer",
			"image": "./Dockerfile",
			"name": "linkedin-games",
			"max_instances": 1,
			"instance_type": "standard"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "DockerContainer",
				"name": "CONTAINER"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"DockerContainer"
			],
			"tag": "v1"
		}
	],
	"observability": {
		"enabled": true
	},
	"dev": {
		"ip": "127.0.0.1",
		"port": 8787
	}
}