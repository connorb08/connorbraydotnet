variable "WORKSPACE_PATH" {
  description = "Path to the workspace."
  default     = "/workspace/connorbraydotnet"
}

variable "BASHRC_D" {
  description = "Path to the bashrc.d directory."
  default     = "$WORKSPACE_PATH/.devcontainer/.bashrc.d"
}

variable "BASE_IMAGE" {
  description = "Image every stage is built on."
  default     = "debian@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6"
}

variable "IMAGE" {
  description = "Repository the final image is tagged into."
  // registry.connorbray.net
  default     = "dev-image"
}

variable "TAG" {
  default = "latest"
}

variable "LAYERS_JSON" {
  description = "JSON array of layer names, in COPY order. Generated by .devcontainer/bake.sh."
  default     = "[]"
}

variable "layers" {
  default = jsondecode(LAYERS_JSON)
}

variable "BUILDER_PACKAGES" {
  description = "base apt packages installed before building layers"
  type        = list(string)
  default = [
    "build-essential",
    "ca-certificates",
    "curl",
    "git",
    "libicu76",
    "python3",
    "python3-venv",
    "unzip",
    "xz-utils",
  ]
}

variable "PACKAGES" {
  description = "packages installed in the final image"
  type        = list(string)
  default = [
    "bash-completion",
    "build-essential",
    "ca-certificates",
    "curl",
    "dnsutils",
    "git",
    "gnupg2",
    "inetutils-telnet",
    "iproute2",
    "iputils-ping",
    "less",
    "libatomic1",
    "libevent-dev",
    "locales",
    "netcat-openbsd",
    "openssh-client",
    "pass",
    "sudo",
    "traceroute",
    "unzip",
    "util-linux",
    "uuid-runtime",
    "wget",
    "xauth",
    "xdg-utils",
    "xz-utils",
  ]
}

variable "USER_NAME" {
  default = "dev"
}

variable "USER_UID" {
  type    = number
  default = 1000
}

variable "USER_GID" {
  type    = number
  default = USER_UID
}

variable "REPO_URL" {
  default = ""
}

variable "VCS_REF" {
  default = ""
}

// Dockerfile RUN line that installs a list of apt packages in one transaction.
// apt caches are BuildKit cache mounts, so nothing apt-related lands in the
// layer and re-builds don't re-download packages.
function "apt_install" {
  params = [packages]
  result = <<-EOT
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        ${join(" \\\n        ", sort(distinct(packages)))}
EOT
}

// ---------------------------------------------------------------------------
// Targets
// ---------------------------------------------------------------------------

target "base" {
  dockerfile-inline = "FROM ${BASE_IMAGE}"
}

target "builder" {
  contexts = { base = "target:base" }
  dockerfile-inline = <<-DOCKERFILE
FROM base
ENV DEBIAN_FRONTEND=noninteractive
${apt_install(BUILDER_PACKAGES)}
RUN printf '%s\n' \
    'retry = 4' \
    'retry-max-time = 120' \
    'connect-timeout = 30' \
    'max-time = 120' > /root/.curlrc
DOCKERFILE
}

target "layer" {
  matrix   = { layer = layers }
  name     = "layer-${layer}"
  context  = "layers"
  contexts = { "builder" = "target:builder" }
  dockerfile-inline = <<-DOCKERFILE
FROM builder
SHELL ["/bin/bash", "-e", "-u", "-o", "pipefail", "-c"]
RUN --mount=type=bind,source=${layer}.sh,target=/tmp/install.sh <<DOCKERFILE_EOF
mkdir -p "/opt/build-${layer}/var/log/cbdn"
INSTALL_PREFIX="/opt/build-${layer}" bash -e -u -o pipefail -x /tmp/install.sh 2>&1 | tee "/opt/build-${layer}/var/log/cbdn/layer.${layer}.log"
DOCKERFILE_EOF
DOCKERFILE
}

target "default" {
  context = "."
  contexts = merge(
    { base = "target:base" },
    { for l in layers : "layer-${l}" => "target:layer-${l}" },
  )
  tags = ["${IMAGE}:${TAG}"]
  args = {
    USER_NAME = USER_NAME
    USER_UID  = USER_UID
    USER_GID  = USER_GID
  }
  labels = {
    "org.opencontainers.image.title"    = "connorbray-dev"
    "org.opencontainers.image.revision" = VCS_REF
    "org.opencontainers.image.url"      = REPO_URL
  }
  dockerfile-inline = <<-DOCKERFILE
FROM base

ARG USER_NAME
ARG USER_UID
ARG USER_GID

# Packages
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-e", "-u", "-o", "pipefail", "-c"]
${apt_install(concat(BUILDER_PACKAGES, PACKAGES))}

# Install Layers
${join("\n", [for l in layers : "COPY --link --from=layer-${l} /opt/build-${l} /"])}

# Run Configure
RUN --mount=type=bind,source=configure.sh,target=/tmp/build/configure.sh sh -e -u /tmp/build/configure.sh

# Load environment variables into /etc/environment
RUN env > /etc/environment

# Create user with passwordless sudo
RUN <<DOCKERFILE_EOF
cat <<'EOF' > /etc/skel/.bashrc

if [ -d "${BASHRC_D}" ]; then
  for i in "${BASHRC_D}"/*.sh; do
    if [ -r "$i" ]; then
      . "$i"
    fi
  done
  unset i
fi
EOF

groupadd --gid $USER_GID $USER_NAME
useradd --uid $USER_UID --gid $USER_GID --create-home $USER_NAME --shell /usr/bin/bash
echo "$USER_NAME ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/$USER_NAME
chmod 0440 /etc/sudoers.d/$USER_NAME
DOCKERFILE_EOF
COPY docker-host-entrypoint.sh /usr/local/bin/docker-host-entrypoint.sh
RUN chmod 0755 /usr/local/bin/docker-host-entrypoint.sh
ENV DEVCONTAINER_USER=$USER_NAME
ENV HOME=/home/$USER_NAME
USER root
ENTRYPOINT ["/usr/local/bin/docker-host-entrypoint.sh"]
CMD ["sleep", "infinity"]
DOCKERFILE
}
