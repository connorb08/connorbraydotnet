{
	"name": "linkedin-game-solver",
	"type": "module",
	"version": "1.0.0",
	"author": "Connor Bray",
	"description": "Constraint propagation solver for the LinkedIn N-Queens game.",
	"license": "MIT",
	"main": "dev.ts",
	"imports": {
		"#/*": "./src/*.ts",
		"#config": "./src/config.ts"
	},
	"scripts": {
		"dev": "bun run dev.ts",
		"debug": "CLOG_LEVEL=all bun run dev.ts",
		"cf": "wrangler dev",
		"cf:debug": "CLOG_LEVEL=all wrangler dev --remote",
		"cron": "curl localhost:8787/cron",
		"typegen": "wrangler types worker/worker-configuration.d.ts",
		"pretypecheck": "bun run typegen",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"shared": "workspace:*",
		"clog": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/playwright": "^0.0.10"
	},
	"peerDependencies": {
		"typescript": "*",
		"wrangler": "*",
		"playwright": "*"
	}
}
