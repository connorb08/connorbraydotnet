{
	"extends": "./tsconfig.json",
	"include": [
		"test/**/*",
		"worker-configuration.d.ts",
		"build",
		"workers",
		"vite-env.d.ts",
		"app/**/*.spec.tsx",
		"app/**/*",
		".react-router/types/**/*"
	],
	"exclude": ["test/e2e"],
	"compilerOptions": {
		"composite": true,
		"types": [
			"@cloudflare/vitest-pool-workers",
			"vitest/globals",
			"@testing-library/jest-dom"
		],
		"lib": ["ESNext", "DOM"],
		"allowJs": true,
		"rootDirs": [".", "./.react-router/types"],
		"jsx": "react-jsx"
	}
}
