{
	"name": "site",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"typegen": "wrangler types 1> /dev/null && react-router typegen",
		"deploy": "bun run build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "bun run build && vite preview",
		"typecheck": "nx run typegen && tsc -b",
		"lint": "biome lint",
		"format": "biome format --write",
		"depcheck": "bunx depcheck"
	},
	"imports": {
		"#app/*": "./src/app/*.ts",
		"#components/*": "./src/components/*/index.tsx",
		"#pages/*": "./src/pages/*/index.tsx",
		"#utils": "./src/utils/index.ts",
		"#utils/*": "./src/utils/*.ts",
		"#config": "./src/config.ts"
	},
	"dependencies": {
		"isbot": "^5.1.17",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^7.5.0",
		"shared": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.0.0",
		"@react-router/dev": "^7.5.0",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.1",
		"react-icons": "^5.5.0",
		"vite": "^6.2.1",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"peerDependencies": {
		"sass": "*"
	},
	"packageManager": "bun@10.8.0"
}
