{
	"name": "@connorbraydotnet/source",
	"version": "0.0.0",
	"license": "UNLICENSED",
	"private": true,
	"packageManager": "bun@10.8.0",
	"workspaces": [
		"apps/*",
		"sites/*",
		"services/**/*",
		"packages/*",
		"projects/*",
		"inf/"
	],
	"scripts": {
		"checks": "NX_TUI=false bun run format:check && NX_TUI=false bun run lint && NX_TUI=false bun run typecheck && NX_TUI=false bun run build && NX_TUI=false bun run test",
		"format:check": "nx run-many -t format:check",
		"format:write": "nx run-many -t format:write",
		"lint": "nx run-many -t lint",
		"typegen": "nx run-many -t typegen",
		"typecheck": "nx run-many -t typecheck",
		"test": "nx run-many -t test",
		"build": "nx run-many -t build",
		"cloc": "bunx cloc $(git ls-files) --exclude-ext=d.ts --exclude-list-file=.clocignore",
		"depcheck": "nx run-many -t depcheck",
		"check:packages": "bun pm",
		"deploy:preview": "nx run-many -t deploy:preview"
	},
	"imports": {
		"#workspace/*": "./*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.2",
		"@biomejs/js-api": "^0.7.1",
		"@biomejs/wasm-nodejs": "^1.9.4",
		"@cloudflare/vite-plugin": "^1.40.0",
		"@cloudflare/vitest-pool-workers": "^0.12.0",
		"@cloudflare/workers-types": "^4.20250404.0",
		"@mantine/core": "^9.2.2",
		"@mantine/hooks": "^9.2.2",
		"@nx/esbuild": "22.3.3",
		"@nx/eslint": "22.3.3",
		"@nx/eslint-plugin": "22.3.3",
		"@nx/js": "22.3.3",
		"@nx/node": "22.3.3",
		"@nx/playwright": "22.1.0",
		"@nx/react": "22.1.0",
		"@nx/vite": "22.1.0",
		"@nx/vitest": "22.1.0",
		"@playwright/test": "^1.52.0",
		"@react-router/dev": "^7.16.0",
		"@swc-node/register": "~1.9.1",
		"@swc/core": "~1.5.7",
		"@swc/helpers": "~0.5.11",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "^1.3.6",
		"@types/css-modules": "^1.0.5",
		"@types/node": "^22.15.3",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.4.1",
		"@vitest/coverage-istanbul": "^3.2.4",
		"@vitest/coverage-v8": "^3.2.4",
		"ajv": "^8.17.1",
		"ajv-cli": "^5.0.0",
		"ajv-formats": "^3.0.1",
		"depcheck": "^1.4.7",
		"esbuild": "^0.19.2",
		"jsdom": "^26.1.0",
		"nx": "22.1.0",
		"playwright": "^1.54.1",
		"postcss": "^8.5.15",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"tslib": "^2.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.40.0",
		"vite": "8.0.11",
		"vite-plugin-react-remove-attributes": "^1.0.3",
		"vitest": "^4.1.8",
		"wrangler": "^4.107.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1079.0",
		"@aws-sdk/s3-request-presigner": "^3.1079.0",
		"hono": "^4.12.28",
		"isbot": "^5.1.28",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^7.16.0"
	}
}
