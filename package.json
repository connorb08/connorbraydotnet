{
	"name": "@connorbraydotnet/source",
	"version": "0.0.0",
	"license": "UNLICENSED",
	"private": true,
	"packageManager": "bun@10.8.0",
	"workspaces": [
		"apps/*",
		"packages/*",
		"projects/*",
		"inf/"
	],
	"scripts": {
		"checks": "bun run build && bun run test && bun run typecheck && bun run format && bun run lint",
		"format": "biome format && nx run-many -t format",
		"lint": "biome lint && nx run-many -t lint",
		"typecheck": "nx run-many -t typecheck",
		"test": "nx run-many -t test",
		"build": "nx run-many -t build",
		"cloc": "bunx cloc $(git ls-files) --exclude-ext=d.ts --exclude-list-file=.clocignore",
		"depcheck": "nx run-many -t depcheck",
		"check:packages": "bun pm"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.6",
		"@biomejs/js-api": "^0.7.1",
		"@biomejs/wasm-nodejs": "^1.9.4",
		"@cloudflare/vite-plugin": "^1.9.4",
		"@cloudflare/vitest-pool-workers": "^0.8.53",
		"@nx/js": "20.8.0",
		"@nx/playwright": "20.8.0",
		"@nx/react": "20.8.0",
		"@nx/vite": "20.8.0",
		"@playwright/test": "^1.52.0",
		"@react-router/dev": "^7.6.3",
		"@swc-node/register": "~1.9.1",
		"@swc/core": "~1.5.7",
		"@swc/helpers": "~0.5.11",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "^1.2.13",
		"@types/node": "^22.15.3",
		"@vitejs/plugin-react": "^4.4.1",
		"@vitest/coverage-istanbul": "^3.1.3",
		"ajv": "^8.17.1",
		"ajv-cli": "^5.0.0",
		"ajv-formats": "^3.0.1",
		"depcheck": "^1.4.7",
		"jsdom": "^26.1.0",
		"nx": "20.8.0",
		"playwright": "^1.54.1",
		"tslib": "^2.3.0",
		"typescript": "^5.8.3",
		"vite": "^7.0.4",
		"vite-plugin-react-remove-attributes": "^1.0.3",
		"vitest": "^3.2.4",
		"wrangler": "^4.24.3"
	},
	"dependencies": {
		"isbot": "^5.1.28",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.6.3"
	}
}
