{
	"name": "@connorbraydotnet/source",
	"version": "0.0.0",
	"license": "UNLICENSED",
	"private": true,
	"packageManager": "bun@10.8.0",
	"workspaces": [
		"apps/*",
		"sites/*",
		"services/**/*",
		"packages/*",
		"projects/*",
		"inf/"
	],
	"overrides": {
		"typescript": "npm:@typescript/typescript6@6.0.2"
	},
	"scripts": {
		"checks": "NX_TUI=false bun run format:check && NX_TUI=false bun run lint && NX_TUI=false bun run typecheck && NX_TUI=false bun run build && NX_TUI=false bun run test",
		"format:check": "nx run-many -t format:check",
		"format:write": "nx run-many -t format:write",
		"lint": "nx run-many -t lint",
		"typegen": "nx run-many -t typegen",
		"typecheck": "nx run-many -t typecheck",
		"test": "nx run-many -t test",
		"build": "nx run-many -t build",
		"cloc": "bunx cloc $(git ls-files) --exclude-ext=d.ts --exclude-list-file=.clocignore",
		"depcheck": "nx run-many -t depcheck",
		"check:packages": "bun pm",
		"deploy:preview": "nx run-many -t deploy:preview"
	},
	"imports": {
		"#workspace/*": "./*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@biomejs/js-api": "6.0.0",
		"@biomejs/wasm-nodejs": "2.5.14",
		"@cloudflare/vite-plugin": "1.56.0",
		"@cloudflare/vitest-plugin": "^1.1.13",
		"@cloudflare/workers-types": "5.20260920.1",
		"@mantine/core": "9.6.1",
		"@mantine/hooks": "9.6.1",
		"@nx/esbuild": "23.2.1",
		"@nx/eslint": "23.2.1",
		"@nx/eslint-plugin": "23.2.1",
		"@nx/js": "23.2.1",
		"@nx/node": "23.2.1",
		"@nx/playwright": "23.2.1",
		"@nx/react": "23.2.1",
		"@nx/vite": "23.2.1",
		"@nx/vitest": "23.2.1",
		"@playwright/test": "1.63.0",
		"@react-router/dev": "8.4.0",
		"@swc-node/register": "1.12.1",
		"@swc/core": "1.16.2",
		"@swc/helpers": "0.5.23",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/bun": "1.4.2",
		"@types/css-modules": "1.0.5",
		"@types/node": "26.6.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-istanbul": "5.0.1",
		"@vitest/coverage-v8": "5.0.1",
		"ajv": "8.20.0",
		"ajv-cli": "5.0.0",
		"ajv-formats": "3.0.1",
		"depcheck": "1.4.7",
		"esbuild": "0.28.2",
		"jsdom": "30.1.0",
		"nx": "23.2.1",
		"playwright": "1.63.0",
		"postcss": "8.5.28",
		"postcss-preset-mantine": "1.18.0",
		"postcss-simple-vars": "7.0.1",
		"tslib": "2.8.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-7": "npm:typescript@7.0.2",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0",
		"vite-plugin-react-remove-attributes": "1.0.3",
		"vitest": "5.0.1",
		"wrangler": "4.135.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1136.0",
		"@aws-sdk/s3-request-presigner": "3.1136.0",
		"hono": "4.13.8",
		"isbot": "5.2.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.4.0"
	}
}
