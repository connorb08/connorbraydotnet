		"wrangler": "*",
		"vitest": "*",
		"@cloudflare/vitest-pool-workers": "*",
		"vite": "*",
		"react-router": "*",
		"react": "*",
		"react-dom": "*",
		"isbot": "*",
		"typescript": "*",
		"@types/react": "*",
		"@types/react-dom": "*",
		"@cloudflare/vite-plugin": "*",
		"@react-router/dev": "*"
	}
}
