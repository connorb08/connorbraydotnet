{
	"name": "site",
	"private": true,
	"type": "module",
	"imports": {
		"#app/*": "./app/*.ts",
		"#components/*": "./components/*.tsx",
		"#pages/*": "./pages/*/index.tsx",
		"#context/*": "./utils/context/*.ts",
		"#utils": "./utils/index.ts",
		"#utils/*": "./utils/*.ts",
		"#providers/*": "./utils/providers/*.tsx",
		"#hooks": "./utils/hooks.ts",
		"#config": "./config.ts",
		"#styles/": "./styles/*",
		"#data/*": "./data/*.tsx"
	},
	"scripts": {
		"build": "react-router build",
		"typegen": "wrangler types -c wrangler.json -c ../../services/db/wrangler.json -c ../../services/api/wrangler.json -c ../../services/database/wrangler.json -c ../../services/content-manager/wrangler.json && react-router typegen",
		"deploy": "nx run build && wrangler deploy",
		"deploy:preview": "nx run build && wrangler deploy --env preview",
		"dev": "react-router dev",
		"preview": "nx run build && vite preview",
		"typecheck": "bun run typegen && tsc -b",
		"test": "vitest run",
		"depcheck": "bunx depcheck"
	},
	"dependencies": {
		"components": "workspace:*",
		"react-aria-components": "^1.10.1",
		"schemas": "workspace:*"
	},
	"devDependencies": {
		"@react-router/dev": "^7.13.0",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.1",
		"react-icons": "^5.5.0",
		"sass-embedded": "^1.89.2",
		"typescript-plugin-css-modules": "^5.1.0"
	},
	"peerDependencies": {
		"@cloudflare/vite-plugin": "*",
		"@mantine/core": "*",
		"@mantine/hooks": "*",
		"@types/node": "*",
		"isbot": "*",
		"postcss": "*",
		"postcss-preset-mantine": "*",
		"postcss-simple-vars": "*",
		"react": "*",
		"react-dom": "*",
		"react-router": "*",
		"vite": "*",
		"wrangler": "*"
	}
}
