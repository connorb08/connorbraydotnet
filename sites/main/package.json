{
	"name": "site",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"typegen": "wrangler types -c wrangler.json -c ../../services/api/wrangler.json -c ../../services/database/wrangler.json -c ../../services/content-manager/wrangler.json && react-router typegen",
		"deploy": "nx run build && wrangler deploy",
		"deploy:preview": "nx run build && wrangler deploy --env preview",
		"dev": "react-router dev",
		"preview": "nx run build && vite preview",
		"typecheck": "nx run typegen && tsc -b",
		"depcheck": "bunx depcheck"
	},
	"imports": {
		"#app/*": "./app/*.ts",
		"#components/*": "./components/*/index.tsx",
		"#pages/*": "./pages/*/index.tsx",
		"#utils": "./utils/index.ts",
		"#utils/*": "./utils/*.ts",
		"#config": "./config.ts",
		"#styles/": "./styles/*",
		"#data/*": "./data/*.tsx"
	},
	"dependencies": {
		"components": "workspace:*",
		"react-aria-components": "^1.10.1",
		"shared": "workspace:*",
		"wrangler": "^4.98.0"
	},
	"devDependencies": {
		"@material/material-color-utilities": "^0.3.0",
		"@react-router/dev": "^7.13.0",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.1",
		"react-icons": "^5.5.0",
		"sass-embedded": "^1.89.2",
		"typescript-plugin-css-modules": "^5.1.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.11"
	},
	"peerDependencies": {
		"isbot": "*",
		"react": "*",
		"react-dom": "*",
		"react-router": "*",
		"vite": "*",
		"@cloudflare/vite-plugin": "*",
		"@types/node": "*",
		"@mantine/core": "*",
		"@mantine/hooks": "*",
		"postcss": "*",
		"postcss-preset-mantine": "*",
		"postcss-simple-vars": "*"
	},
	"packageManager": "bun@10.8.0"
}
