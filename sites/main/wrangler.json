/**
 * Wrangler configuration:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "connorbray-net",
	"compatibility_date": "2025-07-26",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"vars": {
		"COOKIE_SECRET": ""
	},
	"routes": [
		{
			"pattern": "connorbray.net",
			"custom_domain": true
		}
	],
	"preview_urls": false,
	"services": [
		{
			"binding": "CONTENT_MANAGER",
			"service": "content-manager",
			"entrypoint": "MainEntrypoint"
		},
		{
			"binding": "DATABASE",
			"service": "database",
			"entrypoint": "Entrypoint"
		}
	],
	"env": {
		"preview": {
			"route": {
				"pattern": "preview.connorbray.net",
				"custom_domain": true
			},
			"services": [
				{
					"binding": "CONTENT_MANAGER",
					"service": "content-manager",
					"entrypoint": "MainEntrypoint"
				},
				{
					"binding": "DATABASE",
					"service": "database",
					"entrypoint": "Entrypoint"
				}
			]
		}
	}
}
