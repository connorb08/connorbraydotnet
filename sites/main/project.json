{
	"name": "site",
	"targets": {
		"deploy:preview": {},
		"deploy:prod": {},
		"lint": {},
		"format:check": {},
		"format:write": {},
		"build": {
			"cache": true,
			"dependsOn": ["^build"],
			"inputs": [
				"{projectRoot}/**/*",
				"!{projectRoot}/project.json",
				"!{projectRoot}/tsconfig.json",
				"!{projectRoot}/tsconfig.*.json",
				"!{projectRoot}/README.md",
				"!{projectRoot}/.gitignore",
				"!{projectRoot}/.depcheckrc"
			]
		},
		"typegen": {
			"cache": true,
			"dependsOn": [
				{ "target": "typecheck", "projects": "content-manager" },
				{ "target": "typecheck", "projects": "database" }
			],
			"inputs": [
				"{projectRoot}/**/*",
				"!{projectRoot}/project.json",
				"!{projectRoot}/README.md",
				"!{projectRoot}/.gitignore",
				"!{projectRoot}/.depcheckrc"
			],
			"outputs": ["{projectRoot}/worker-configuration.d.ts"]
		}
	}
}
