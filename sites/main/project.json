{
	"name": "site",
	"targets": {
		"lint": {},
		"format:check": {},
		"format:write": {},
		"build": {
			"cache": true,
			"inputs": [
				"{projectRoot}/**/*",
				"!{projectRoot}/package.json",
				"!{projectRoot}/project.json",
				"!{projectRoot}/.env",
				"!{projectRoot}/tsconfig.json",
				"!{projectRoot}/tsconfig.*.json",
				"!{projectRoot}/README.md",
				"!{projectRoot}/.gitignore"
			]
		},
		"typegen": {
			"cache": true,
			"inputs": [
				"{projectRoot}/**/*",
				"!{projectRoot}/package.json",
				"!{projectRoot}/project.json",
				"!{projectRoot}/tsconfig.json",
				"!{projectRoot}/tsconfig.*.json",
				"!{projectRoot}/README.md",
				"!{projectRoot}/.gitignore"
			]
		}
	}
}
