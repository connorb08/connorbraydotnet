{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "admin",
	"compatibility_date": "2026-02-10",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"main": "./workers/app.ts",
	"routes": [
		{
			"pattern": "admin.connorbray.net",
			"custom_domain": true
		}
	],
	"services": [
		{
			"binding": "CONTENT_MANAGER",
			"service": "content-manager",
			"entrypoint": "MainEntrypoint"
		},
		{
			"binding": "DB",
			"service": "db",
			"entrypoint": "Entrypoint"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
