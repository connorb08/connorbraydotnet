{
	"extends": "./tsconfig.json",
	"include": ["vite.config.ts"],
	"compilerOptions": {
		"tsBuildInfoFile": ".tsbuildinfo/tsconfig.node.tsbuildinfo",
		"composite": true,
		"strict": true,
		"types": ["node"],
		"lib": ["ES2022"],
		"target": "ES2022",
