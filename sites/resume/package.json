{
	"name": "resume",
	"private": true,
	"type": "module",
	"imports": {
		"#app/*": "./app/*",
		"#styles/*": "./app/styles/*",
		"#models": "./models/index.ts",
		"#validate": "./validate/index.ts",
		"#validate/validate.js": "./validate/validate.js",
		"#worker": "./workers/app.ts",
		"#test/*": "./test/*.ts",
		"#context": "./app/context.ts"
	},
	"scripts": {
		"build": "react-router build",
		"typegen-cf": "wrangler types 1> /dev/null",
		"typegen-rr": "react-router typegen",
		"typegen": "bun run typegen-cf && bun run typegen-rr",
		"deploy": "bun run build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "bun run build && vite preview",
		"pretest": "bun run typegen && react-router build 1> /dev/null",
		"test": "vitest --run",
		"e2e": "nx playwright:e2e",
		"test:watch": "nx run build && vitest",
		"coverage": "vitest run --coverage",
		"format": "biome format --write",
		"lint": "biome lint",
		"typecheck": "nx run typegen && tsc -b",
		"depcheck": "bunx depcheck"
	},
	"dependencies": {
		"schemas": "workspace:*"
	},
	"devDependencies": {
		"sass-embedded": "^1.87.0"
	},
	"peerDependencies": {
		"@cloudflare/vite-plugin": "*",
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@happy-dom/global-registrator": "*",
		"@playwright/test": "*",
		"@react-router/dev": "*",
		"@testing-library/dom": "*",
		"@testing-library/jest-dom": "*",
		"@testing-library/react": "*",
		"@types/react": "*",
		"@types/react-dom": "*",
		"@vitejs/plugin-react": "*",
		"@vitest/coverage-istanbul": "*",
		"happy-dom": "*",
		"isbot": "*",
		"react": "*",
		"react-dom": "*",
		"react-router": "*",
		"vite": "*",
		"vite-plugin-react-remove-attributes": "*",
		"vitest": "*"
	}
}
