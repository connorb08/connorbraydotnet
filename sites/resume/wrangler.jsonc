{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "resume",
	"compatibility_date": "2025-04-04",
	"main": "./workers/app.ts",
	"preview_urls": false,
	"routes": [
		{
			"custom_domain": true,
			"pattern": "resume.connorbray.net"
		}
	],
	"vars": {
		"HELLO_WORLD": null
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"integration": {
			"vars": {
				"HELLO_WORLD": "Hello, world!"
			}
		}
	},
	"dev": {
		"ip": "127.0.0.1"
	}
}
