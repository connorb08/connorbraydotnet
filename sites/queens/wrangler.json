/**
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "linkedin-games",
	"main": "worker/index.ts",
	"compatibility_date": "2025-05-06",
	"workers_dev": false,
	"routes": [
		{
			"custom_domain": true,
			"pattern": "queens.connorbray.net"
		}
	],
	"services": [
		{
			"service": "database",
			"binding": "DATABASE",
			"entrypoint": "Entrypoint",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"CLOG_LEVEL": "debug"
	},
	"dev": {
		"ip": "127.0.0.1"
	}
}
