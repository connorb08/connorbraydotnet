{
	"$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!node_modules/**",
			"!**/*/node_modules/**",
			"!**/.nx",
			"!**/.react-router",
			"!**/worker-configuration.d.ts",
			"!**/README.md",
			"!**/coverage",
			"!**/test/reports",
			"!**/test/e2e-results",
			"!**/validator/index.d.ts",
			"!**/validate.js",
			"!**/build",
			"!**/.gitignore",
			"!**/.wrangler"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": "error",
			"performance": "error",
			"security": "error",
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"style": "error",
			"suspicious": {
				"noArrayIndexKey": "info"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.ts", "**/*.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"useImportExtensions": "off"
					},
					"style": {
						"noDefaultExport": "off"
					},
					"nursery": {
						"useExplicitType": "off",
						"noUnresolvedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["**/wrangler.json"],
			"json": {
				"parser": {
					"allowComments": true
				}
			}
		}
	]
}
