{
	"name": "inf-cloudflare",
	"private": true,
	"type": "module",
	"main": "index.ts",
	"dependencies": {
		"@root/inf": "workspace:*"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"deploy:preview": "pulumi preview",
		"deploy": "pulumi up"
	},
	"peerDependencies": {
		"@pulumi/cloudflare": "*",
		"@pulumi/pulumi": "*",
		"awilix": "*"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"nx": {
		"targets": {
			"deploy:preview": {
				"cache": false
			},
			"deploy": {
				"cache": false
			}
		}
	}
}
