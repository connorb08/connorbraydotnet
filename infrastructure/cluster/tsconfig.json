{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"rootDir": "..",
		"outDir": ".tsbuildinfo"
	},
	"include": [
		"**/*.ts",
		"../shared/*.ts",
		"../cloud/*/src/**/*.ts",
		"../cloud/cloudflare/*.ts",
		"../backend/src/**/*.ts",
		"../kubes/src/**/*.ts"
	],
	"exclude": ["../**/node_modules/**", "../**/.tsbuildinfo/**"]
}
