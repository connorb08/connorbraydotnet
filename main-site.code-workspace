{
	"folders": [
		{
			"name": "site",
			"path": "./sites/main"
		},
		{
			"name": "content",
			"path": "./services/content-manager"
		},
		{
			"name": "database",
			"path": "./services/database"
		},
		{
			"name": "api",
			"path": "./services/api"
		},
		{
			"name": "types",
			"path": "./packages/types"
		},
		{
			"name": "root",
			"path": "."
		}
	],
	"settings": {
		"explorer.fileNesting.enabled": true,
		"explorer.fileNesting.patterns": {
			"*.tsx": "${capture}.module.scss, ${capture}.spec.tsx",
			"wrangler.json": "worker-configuration.d.ts",
			"vite.config.ts": "vitest.config.ts",
			"README.md": ".gitignore, .gitattributes, .pre-commit-config.yaml, .depcheckrc, .clocignore",
			"package.json": "false"
		},
		"explorer.excludeGitIgnore": false,
		"explorer.sortOrder": "foldersNestsFiles",
		"files.exclude": {
			"**/node_modules": true,
			"**/.react-router": true,
			"**/.wrangler": true,
			"**/*.tsbuildinfo": true,
			"**/build": true,
			"bun.lock": true
		},
		"editor.codeActionsOnSave": {
			// "source.organizeImports.biome": "explicit",
			"source.fixAll.biome": "explicit"
		},
		"nxConsole.generateAiAgentRules": true
	}
}
