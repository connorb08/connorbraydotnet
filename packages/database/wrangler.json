{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "database",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"migrations": [
		{
			"new_sqlite_classes": ["DatabaseObject"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "DatabaseObject",
				"name": "DATABASE"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"ip": "127.0.0.1"
	}
}
