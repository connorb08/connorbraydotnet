{
	"name": "site",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types 1> /dev/null",
		"deploy": "bun run build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "bun run build && vite preview",
		"typecheck": "bun run cf-typegen && react-router typegen && tsc -b",
		"lint": "biome lint",
		"format": "biome format --write",
		"depcheck": "bunx depcheck"
	},
	"imports": {
		"#app/*": "./app/*.ts",
		"#components/*": "./app/components/*/index.tsx"
	},
	"dependencies": {
		"isbot": "^5.1.17",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^7.5.0",
		"shared": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.0.0",
		"@react-router/dev": "^7.5.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.1",
		"react-icons": "^5.5.0",
		"vite": "^6.2.1",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"peerDependencies": {
		"sass": "*"
	},
	"packageManager": "bun@10.8.0"
}
