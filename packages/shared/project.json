{
	"name": "shared",
	"targets": {
		"lint": {},
		"format:check": {},
		"format:write": {},
		"build": {
			"cache": true,
			"inputs": ["{projectRoot}/src", "!{projectRoot}/src/validate"],
			"outputs": ["{projectRoot}/validator"]
		},
		"test": {
			"cache": true,
			"inputs": ["{projectRoot}/src", "{projectRoot}/validator", "{projectRoot}/test"]
		}
	}
}
