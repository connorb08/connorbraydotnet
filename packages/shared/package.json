{
	"name": "shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "bun run build.ts",
		"test": "vitest --run",
		"coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome lint && biome format",
		"depcheck": "depcheck",
		"typecheck": "tsc -b"
	},
	"imports": {
		"#types": "./src/types/index.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./test-data": "./src/test-data.ts"
	},
	"peerDependencies": {
		"typescript": "*",
		"ajv": "*",
		"ajv-formats": "*",
		"@biomejs/js-api": "*",
		"vitest": "*",
		"@vitest/coverage-istanbul": "*",
		"@types/bun": "*",
		"depcheck": "*"
	}
}
