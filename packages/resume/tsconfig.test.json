{
	"extends": "./tsconfig.json",
	"include": [
		"test/**/*",
		"worker-configuration.d.ts",
		"build",
		"workers",
		"vite-env.d.ts",
		"app/**/*.spec.tsx",
		"app/**/*"
	],
	"exclude": ["test/e2e"],
	"compilerOptions": {
		"composite": true,
		"types": [
			"@cloudflare/vitest-pool-workers",
			"vitest/globals",
			"@testing-library/jest-dom"
		],
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"strict": true,
		"jsx": "react-jsx"
	}
}
