{
	"name": "resume",
	"targets": {
		"format": {
			"cache": true,
			"inputs": ["{projectRoot}"]
		},
		"lint": {
			"cache": true,
			"inputs": ["{projectRoot}"]
		},
		"build": {
			"cache": true,
			"inputs": [
				"{projectRoot}/app",
				"{projectRoot}/models",
				"{projectRoot}/validate",
				"{projectRoot}/workers"
			],
			"outputs": ["{projectRoot}/build"]
		},
		"test": {
			"cache": true,
			"inputs": [
				"{projectRoot}/app",
				"{projectRoot}/models",
				"{projectRoot}/validate",
				"{projectRoot}/workers",
				"{projectRoot}/vitest.config.ts"
			],
			"outputs": ["{projectRoot}/coverage"]
		},
		"typegen": {
			"cache": true,
			"inputs": ["{projectRoot}/wrangler.jsonc", "{projectRoot}/app/routes.ts"],
			"outputs": [
				"{projectRoot}/worker-configuration.d.ts",
				"{projectRoot}/.react-router/types"
			]
		}
	}
}
